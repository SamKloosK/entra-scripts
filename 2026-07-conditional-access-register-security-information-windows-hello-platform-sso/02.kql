// From: https://argusit.nl/en/blog/conditional-access-register-security-information-windows-hello-platform-sso
// Section: Testing the change
// Read the post first and test in a non-production tenant.

let regPolicies = dynamic(["CA-RegisterSecInfo-TrustedLocations", "CA-RegisterSecInfo-AuthStrength"]);
SigninLogs
| where TimeGenerated > ago(14d)
| mv-expand cap = ConditionalAccessPolicies
| where tostring(cap.displayName) in (regPolicies)
| where tostring(cap.result) !in ("notApplied", "notEnabled")
| summarize Count = count() by AppDisplayName, ResourceDisplayName, Policy = tostring(cap.displayName), Result = tostring(cap.result), ResultType
| order by Count desc
